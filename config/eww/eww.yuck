(deflisten currentvolume `scripts/getvol`)
(deflisten volumemuted `scripts/getmute`)
(deflisten notif_bar :initial '{"count":0,"dnd":false,"inhibited":false,"center_open":false}'
  "~/.config/eww/scripts/notifd-listen bar")  ; scripts/notifd's state (widgets/notifications.yuck)
;; Media state (`player`) comes from widgets/dashboard.yuck's deflisten: playerctld
;; follows the most recently active player, so no per-player bookkeeping here.
;; Color per monitor for text straight on the wallpaper, picked from the
;; wallpaper behind it: {"<connector>": {"left": "tone-<color>[ low-contrast]",
;; "right": ...}}. left is the strip behind the media text, right the one
;; between the center pill and the sensors pill (Claude session list). The
;; script caches by wallpaper + monitor geometry, so the hourly re-check (which
;; catches a wallpaper change) is a file read; `bar-text-tone --apply` updates
;; at once.
(defpoll bar_tone :interval "1h" :initial "{}" "scripts/bar-text-tone")

;; Claude Code sessions, from the hook state files under
;; $XDG_RUNTIME_DIR/claude-sessions (inotify, no polling):
;; {"count", "alert": "error" | "waiting" | "", "summary", "sessions": [{"id",
;; "pid", "kitty", "project", "state", "label", "since", "detail", "prompt",
;; "cwd", "mode"}, ...]}, oldest session first. alert is already resolved
;; (error wins over waiting); summary is the prebuilt pill tooltip.
(deflisten claude_sessions
  ; slots pre-padded so the fixed entry slots never index past the end
  :initial `{"count": 0, "alert": "", "summary": "", "sessions": [],
             "slots": [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}]}`
  "scripts/claude-sessions")
(defvar claude_list_open false)   ; shared by all bars; scripts/claude-list-toggle
(defvar claude_list_mapped false) ; sets both, unmapping only after the fade-out

(deflisten workspaces :initial "[]" "bash ~/.config/eww/scripts/get-workspaces")

(deflisten current_workspace :initial "1" "bash ~/.config/eww/scripts/get-active-workspace")

(include "widgets/osd.yuck")
(include "widgets/dashboard.yuck")
(include "widgets/notifications.yuck")

; Opened by scripts/launch-eww-bars with --arg monitor=<Hyprland connector>
; (eww 0.5 refuses to open a window when a declared arg is missing, even a
; ?optional one, so every arg added here must be passed there too).
(defwindow bar [monitor]
  :namespace "eww-bar"
  :exclusive true
  :windowtype "dock"
  :stacking "fg"
  :focusable false
  :geometry (geometry
              :width "100%"
              :height "28px"
              :anchor "top center")
  (main_bar :monitor monitor)
)

(defwidget main_bar [monitor]
  (centerbox :class "main_container"
    :orientation "h"
    (box :class "left_modules"
         :orientation "h"
         :space-evenly false
         :halign "start"
         :spacing 12
    (power)
    (workspaces)
    (media_player :monitor monitor))
    (box :class "center_modules"
         :orientation "h"
         :space-evenly false
         :halign "center"
         :spacing 12
    (date)
    (clock))
    (box :class "right_modules"
         :orientation "h"
         :space-evenly false
         :halign "fill" ; claude_list's overlay takes the free room up to the center pill
         :spacing 12
    (claude_list :monitor monitor)
    (sensors)
    (system_tray))
  )
)

(defwidget date []
  (box
    :class "date"
    :orientation "h"
    :spacing 12
    :space-evenly false
    (label :class "date_icon" :text "󰸗")
    (label :text {formattime(EWW_TIME, "%a %d %b")})
  )
)

(defwidget clock []
  (box
    :class "clock"
    :orientation "h"
    :spacing 12
    :space-evenly false
    (label :class "clock_icon" :text "󱑓")
    (label :text {formattime(EWW_TIME, "%H:%M:%S")})
  )
)

(defwidget power []
  (box
    :class "power"
    :orientation "h"
    :space-evenly false
    (eventbox :cursor "pointer" ; button has no :cursor property
              :tooltip "Menu"
      (button :class "power_button"
              :timeout "1s" ; dashboard script does several eww IPC round-trips
              :onclick "~/.config/eww/scripts/dashboard toggle"
              ""))
  )
)

(defwidget workspaces []
  (eventbox
    :onscroll "bash ~/.config/eww/scripts/change-active-workspace {} ${current_workspace}" :class "workspaces_scroll"
    (box
      :class "workspaces"
      :orientation "h"
      :space-evenly true
      :spacing 15
      :halign "start"
      (label
        :text "${workspaces}${current_workspace}"
        :visible false)
      (for workspace in workspaces
        (eventbox
          :onclick "hyprctl dispatch workspace ${workspace.id} || hyprctl dispatch 'hl.dsp.focus({ workspace = ${workspace.id} })'"
          :class "workspace_eventbox"
          :cursor "pointer"
          :tooltip "${workspace.id == 1 ? "Web" :
                      workspace.id == 2 ? "Terminals" :
                        workspace.id == 3 ? "Code" :
                          workspace.id == 4 ? "Mail" :
                            workspace.id == 5 ? "Chat" :
                              workspace.id == 6 ? "Music" :
                                workspace.id == 7 ? "VM" :
                                  workspace.id == 8 ? "Etc1" :
                                    workspace.id == 9 ? "Etc2" :
                                      workspace.id == 10 ? "Etc3" : "Workspace ${workspace.id}"}"
          (box
            :class "workspace_entry ${workspace.id == current_workspace ? "current" : ""} ${workspace.windows > 0 ? "occupied" : "empty"}"
            (label
              :class "workspace_buttons"
              :text "${workspace.id == 1 ? "󰖟" :
                        workspace.id == 2 ? "󰆍" :
                          workspace.id == 3 ? "" :
                            workspace.id == 4 ? "󰇮" :
                              workspace.id == 5 ? "󰍩" :
                                workspace.id == 6 ? "󰎄" :
                                  workspace.id == 7 ? "󰍺" :
                                    workspace.id == 8 ? "󰎥" :
                                      workspace.id == 9 ? "󰎨" :
                                        workspace.id == 10 ? "󰎫" : ""}")
          )
        )
      )
    )
  )
)

;; Fades in and out like the Claude session list (bar_fade); the listener
;; keeps it mapped until the fade-out is done (player.mapped).
(defwidget media_player [monitor]
  (bar_fade :show {player.active && player.show}
            :mapped {player.mapped ?: (player.active && player.show)}
    (box
      :class "media_player ${player.status == "Paused" ? "paused" : ""}"
      :orientation "h"
      :spacing 12
      :space-evenly false
      (media_controls)
      (media_info :monitor monitor)
    )
  )
)

;; Shared show/hide for the content straight on the wallpaper (media player,
;; Claude session list): an opacity fade in CSS (.bar_fade). `show` drives the
;; fade, `mapped` whether the widget exists at all; the owner keeps it mapped
;; until a fade-out is done, so a hidden widget takes no clicks or tooltips.
;; Not a GTK revealer: its first crossfade reveal was drawn into the buffer
;; but never reached the screen (screenshots showed it, the monitor didn't).
(defwidget bar_fade [show mapped]
  (box :class "bar_fade ${show ? "shown" : ""}" :visible mapped
    (children))
)

;; Same glyphs and actions as the dashboard media card.
(defwidget media_controls []
  (box
    :class "media_controls"
    :orientation "h"
    :spacing 12
    :space-evenly false
    (eventbox :cursor "pointer" :tooltip "Previous"
      (button :class "previous_button"
              :onclick "~/.config/eww/scripts/dashboard media previous"
              "󰒮"))
    (eventbox :cursor "pointer" :tooltip {player.status == "Playing" ? "Pause" : "Play"}
      (button :class "play_pause_button"
              :onclick "~/.config/eww/scripts/dashboard media play-pause"
              {player.status == "Playing" ? "󰏤" : "󰐊"}))
    (eventbox :cursor "pointer" :tooltip "Next"
      (button :class "next_button"
              :onclick "~/.config/eww/scripts/dashboard media next"
              "󰒭"))
  )
)

;; Click opens the dashboard (art, seek bar); scroll skips tracks. The tooltip
;; carries the full text the label may truncate.
;;
;; Width adapts to the monitor by itself: :limit-width is GTK max-width-chars
;; plus Pango ellipsizing, so the label's minimum width is just the ellipsis,
;; and the centerbox only ever gives the left side the room up to the center
;; pill. The label shrinks into that (ellipsized by pixel width, so wide CJK
;; glyphs are fine too) and the center never moves. The 500 is only there to
;; switch ellipsizing on; it is never the binding limit.
(defwidget media_info [monitor]
  (eventbox
    :class "media_info_eventbox"
    :cursor "pointer"
    :tooltip "${player.artist != "" ? "${player.artist} – " : ""}${player.title} · ${player.player}"
    :timeout "1s" ; dashboard script does several eww IPC round-trips
    :onclick "~/.config/eww/scripts/dashboard toggle"
    :onscroll "~/.config/eww/scripts/dashboard media {}"
    (box
      :class "media_info on_wallpaper ${bar_tone[monitor]?.left ?: "tone-bg0"}"
      :orientation "h"
      (label :limit-width 500 :show-truncated true
             :text "${player.icon}  ${player.artist != "" ? "${player.artist} - " : ""}${player.title}"))
  )
)

(defwidget sensors []
  (box
    :class "sensors"
    :orientation "h"
    :spacing 12
    :space-evenly false
    (claude)
    (memory)
    (cpu_temperature)
    (cpu)
    (volume)
    (notifications)
    ; The only EWW_BATTERY lookup: safe access (?.) yields "" instead of an
    ; evaluation error on machines without a BAT0.
    (battery :capacity {EWW_BATTERY?.BAT0?.capacity ?: ""}
             :status {EWW_BATTERY?.BAT0?.status ?: ""})
  )
)

;; Claude Code sessions: glyph + count in accent1, blinking orange while a
;; session waits for an answer, blinking red when one errored. Click toggles
;; the session list next to the pill.
(defwidget claude []
  (box
    :class "claude_segment ${claude_sessions.alert != "" ? "alert-${claude_sessions.alert}" : ""}"
    :visible {claude_sessions.count > 0}
    :orientation "h"
    :space-evenly false
    :halign "center"
    (eventbox
      :class "claude_eventbox"
      :cursor "pointer"
      :tooltip {claude_sessions.summary}
      :timeout "1s" ; claude-list-toggle waits out the fade before unmapping
      :onclick "~/.config/eww/scripts/claude-list-toggle"
      (box
        :orientation "h"
        :spacing 12
        :space-evenly false
        :halign "center"
        (label :style "font-size: 20px;" :text "")
        (label :text {claude_sessions.count})
      )
    )
  )
)

;; One entry per session, oldest first, starting next to the center pill;
;; new sessions are added on the right. Glyph on top, project name below,
;; colored by state; idle entries take the wallpaper tone of the right-hand
;; strip (like the media text). Click focuses the session's kitty window/tab.
;;
;; The list lives in an overlay over an empty, expanding box, so it adds
;; nothing to the right side's size request: it gets the free room between the
;; center pill and the sensors pill and never shrinks a pill. When the
;; sessions don't fit, the list scrolls (mouse wheel) inside that room; the
;; names don't ellipsize (in a scroll GTK hands labels their minimum width).
;;
;; Fixed slots instead of a `for`: eww rebuilds every child of a `for` when the
;; list changes, and since a working session changes on every tool call, the
;; entry under the mouse was destroyed and its tooltip closed. Slots only get
;; their properties updated. The listener pads `slots` to 12 entries
;; (scripts/claude-sessions SLOTS); empty ones are {} and stay hidden.
(defwidget claude_list [monitor]
  (overlay
    :hexpand true
    (box) ; sizes the overlay: whatever right_modules has left over
    (scroll
      :class "claude_scroll"
      :visible {claude_list_mapped && claude_sessions.count > 0}
      :hexpand true
      :hscroll true
      :vscroll false
      ; the fade sits inside the scroll, on plain widgets only
      (bar_fade :show claude_list_open :mapped true
        (box
          :class "claude_list"
          :orientation "h"
          :halign "start"
          :spacing 10
          :space-evenly false
          (claude_entry :monitor monitor :s {claude_sessions.slots[0]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[1]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[2]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[3]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[4]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[5]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[6]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[7]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[8]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[9]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[10]})
          (claude_entry :monitor monitor :s {claude_sessions.slots[11]}))
      )
    )
  )
)

(defwidget claude_entry [monitor s]
  (eventbox
    :class "claude_entry_eventbox"
    :visible {(s.id ?: "") != ""}
    :cursor "pointer"
    :tooltip {s.tooltip ?: ""} ; prebuilt by the listener (eww strings have no "\n")
    :timeout "2s" ; claude-focus does hyprctl + kitty remote-control round-trips
    :onclick "~/.config/eww/scripts/claude-focus ${s.pid ?: 0} ${s.kitty ?: 0}"
    (box
      :class "claude_entry on_wallpaper ${bar_tone[monitor]?.right ?: "tone-bg0"} ${s.state ?: ""}"
      :orientation "v"
      :space-evenly false
      (label :class "claude_entry_icon" :text "")
      (label :class "claude_entry_name" :show-truncated false ; no ellipsizing, the listener cuts .name to 16
             :text {s.name ?: ""}))
  )
)

(defwidget memory []
  (box
    :class "memory"
    :tooltip "Memory ${round(EWW_RAM.used_mem / 1073741824, 1)} / ${round(EWW_RAM.total_mem / 1073741824, 1)} GiB"
    :orientation "h"
    :spacing 12
    :halign "center"
    :space-evenly false
    (label :style "font-size: 20px;" :text "")
    (label :text "${round(EWW_RAM.used_mem_perc, 0)}%")
  )
)

(defwidget cpu_temperature []
  (box
    :class "cpu_temperature"
    :tooltip "CPU ${EWW_TEMPS.CORETEMP_PACKAGE_ID_0}°C"
    :orientation "h"
    :spacing 12
    :halign "center"
    :space-evenly false
    (label :style "font-size: 16px;" :text "")
    (label :text "${EWW_TEMPS.CORETEMP_PACKAGE_ID_0}°C")
  )
)

(defwidget cpu []
  (box
    :class "cpu"
    :tooltip "CPU ${round(EWW_CPU.avg, 0)}% across ${arraylength(EWW_CPU.cores)} threads"
    :orientation "h"
    :spacing 12
    :halign "center"
    :space-evenly false
    (label :style "font-size: 20px;" :text "󰍛")
    (label :text "${round(EWW_CPU.avg, 0)}%")
  )
)

(defwidget volume []
  (box
    :class "volume"
    :orientation "h"
    :space-evenly false
    :halign "center"
    (eventbox
      :class "volume_eventbox"
      :cursor "pointer"
      :tooltip {volumemuted == "true" ? "Volume muted" : "Volume ${currentvolume}%"}
      :timeout "2s" ; osd script does several IPC round-trips; past the timeout (default 200ms)
                    ; eww logs "command ... timed out" and kills the sh running the command
      :onscroll "~/.config/eww/scripts/osd volume {} 5"
      :onclick "~/.config/eww/scripts/osd volume mute"
      (box
        :orientation "h"
        :spacing 12
        :space-evenly false
        :halign "center"
        (label :style "font-size: 22px;" :text {volumemuted == "true" ? "󰖁"
          : currentvolume != "" && currentvolume <= 15 ? "󰕿"
          : currentvolume != "" && currentvolume <= 60 ? "󰖀"
          : "󰕾"})
        (label :class {volumemuted == "true" ? "volume-muted" : ""} :text {volumemuted == "true" ? "MUTED" : "${currentvolume}%"})
      )
    )
  )
)

(defwidget notifications []
  (box
    :class "notifications ${notif_bar.dnd ? 'dnd_on' : notif_bar.inhibited ? 'inhibited_on' : ''}"
    :orientation "h"
    :space-evenly false
    :halign "center"
    (eventbox
      :class "notifications_eventbox"
      :cursor "pointer"
      :tooltip "${notif_bar.count} notification${notif_bar.count == 1 ? '' : 's'}${notif_bar.dnd ? ' (do not disturb)' : notif_bar.inhibited ? ' (inhibited)' : ''}"
      :timeout "1s" ; notif-center does several hyprctl/eww calls; the 200 ms default kills it
      :onclick "~/.config/eww/scripts/notif-center toggle"
      :onrightclick "~/.dotfiles/scripts/notifctl dnd toggle"
      (box
        :orientation "h"
        :spacing 12
        :space-evenly false
        :halign "center"
        (label :style "font-size: 20px;" :text {notif_bar.dnd ? "󰂛" : notif_bar.inhibited ? "󰂠" : "󰂚"})
        (label :text {notif_bar.count > 99 ? "99+" : notif_bar.count})
      )
    )
  )
)

(defwidget battery [capacity status] ; "" when there is no BAT0 (desktop), see sensors
  (box
    :class "battery"
    :visible {capacity != ""}
    :tooltip "Battery ${capacity}% · ${status}"
    :orientation "h"
    :spacing 12
    :halign "center"
    :space-evenly false
    (label :text {capacity == "" ? "" :
                  status == 'Charging' ? "󰂄" :
                    status == 'Full' ? "󰂄" :
                      capacity <= 5 ? "󱃍" :
                        capacity <= 10 ? "󰁺" :
                          capacity <= 20 ? "󰁻" :
                            capacity <= 30 ? "󰁼" :
                              capacity <= 40 ? "󰁽" :
                                capacity <= 50 ? "󰁾" :
                                  capacity <= 60 ? "󰁿" :
                                    capacity <= 70 ? "󰂀" :
                                      capacity <= 80 ? "󰂁" :
                                        capacity <= 90 ? "󰂂" :
                                          capacity <= 100 ? "󰁹" : ""})
    (label :text "${capacity}%")
  )
)

(defwidget system_tray []
  (systray :class "system_tray"
           :spacing 5
           :orientation "h"
           :icon-size 24
           :space-evenly true
           :prepend-new false
  )
)

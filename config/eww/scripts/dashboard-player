#!/usr/bin/env bash

# Media state for the dashboard card.
#   dashboard-player            deflisten: one JSON line per metadata/status
#                               change of the active player (playerctld picks
#                               the most recently active one, so no -p)
#   dashboard-player position   one JSON line with position/length for the
#                               1 s poll that runs while the dashboard is open
#
# `playerctl -F` blocks until a player appears, prints on every change and an
# empty line when the last player goes away. The loop restarts it if it ever
# exits (dbus hiccup at login). Album art is copied to a hash-named file under
# $XDG_RUNTIME_DIR: the yuck shows it as a CSS background-image, which only
# reloads when the path changes, and http(s) art needs a local file anyway.

set -u

rt=${XDG_RUNTIME_DIR:-/tmp}
art_dir="$rt/eww-art"

fmt_time() { printf '%d:%02d' $(( $1 / 60 )) $(( $1 % 60 )); }

if [ "${1:-}" = position ]; then
    pos=$(playerctl position 2>/dev/null)
    len=$(playerctl metadata mpris:length 2>/dev/null)
    pos=${pos%%.*}
    [[ $pos =~ ^[0-9]+$ ]] || pos=0
    [[ $len =~ ^[0-9]+$ ]] || len=0
    len=$(( len / 1000000 ))
    pct=0
    if [ "$len" -gt 0 ]; then
        pct=$(( (pos * 100 + len - 1) / len ))
        # pos is whole seconds and the player moves on before pos reaches len,
        # so the last reading is often len-1: count that as finished.
        [ "$pct" -gt 100 ] || [ $(( pos + 1 )) -ge "$len" ] && pct=100
    fi
    printf '{"pct":%d,"pos":"%s","len":"%s"}\n' "$pct" "$(fmt_time "$pos")" "$(fmt_time "$len")"
    exit 0
fi

inactive='{"active":false,"player":"","status":"Stopped","title":"","artist":"","art":"","length":0}'

cache_art() {
    # $1: mpris:artUrl (file:// or http(s)://). Prints the local path or "".
    # Written to a temp file and renamed only on success, so an interrupted
    # copy/download never leaves a truncated file that passes the -s check.
    local url=$1 file tmp src ok=false
    [ -n "$url" ] || { echo ""; return; }
    file="$art_dir/$(printf %s "$url" | md5sum | cut -c1-16).img"
    if [ -s "$file" ]; then
        touch "$file"   # most recently used, for the pruning below
    else
        tmp="$file.tmp.$$"
        case "$url" in
            file://*)
                # Undo percent-encoding. Backslashes are doubled first so %b
                # only decodes the \xHH made from %HH, nothing else in the path.
                src=${url#file://}
                src=${src//\\/\\\\}
                src=$(printf '%b' "${src//%/\\x}" 2>/dev/null)
                cp -f "$src" "$tmp" 2>/dev/null && ok=true
                ;;
            http://*|https://*)
                curl -sf -m 10 -o "$tmp" "$url" 2>/dev/null && ok=true
                ;;
        esac
        if [ "$ok" = true ] && [ -s "$tmp" ]; then
            mv -f "$tmp" "$file"
            # Keep the 20 most recently used; names are hex, so ls is safe.
            ls -t "$art_dir"/*.img 2>/dev/null | tail -n +21 | xargs -r rm -f --
        else
            rm -f "$tmp"
        fi
    fi
    if [ -s "$file" ]; then echo "$file"; else echo ""; fi
}

real_name() {
    # $1: {{playerName}}. Through playerctld that is "playerctld" itself; the
    # player it forwards to is the first of its PlayerNames (most recently
    # active first), e.g. "org.mpris.MediaPlayer2.firefox.instance_1_84" ->
    # "firefox", matching what {{playerName}} gives for a direct connection.
    local n
    [ "$1" = playerctld ] || { echo "$1"; return; }
    n=$(timeout 1 busctl --user --json=short get-property org.mpris.MediaPlayer2.playerctld \
            /org/mpris/MediaPlayer2 com.github.altdesktop.playerctld PlayerNames 2>/dev/null \
        | jq -r '.data[0] // empty' 2>/dev/null)
    n=${n#org.mpris.MediaPlayer2.}
    n=${n%%.*}
    echo "${n:-$1}"
}

mkdir -p "$art_dir"
# Temp files of a copy/download cut short by a kill (the prune only sees *.img).
rm -f "$art_dir"/*.tmp.*
# Unit separator between fields: a whitespace IFS would collapse empty ones
# (no artist) and shift everything after it. Record separator at the end: a
# newline inside a title or artist splits playerctl's output line, so lines
# are joined until one ends with it (a bare empty line means no player).
sep=$'\x1f' eor=$'\x1e'
fmt="{{playerName}}${sep}{{status}}${sep}{{title}}${sep}{{artist}}${sep}{{mpris:artUrl}}${sep}{{mpris:length}}${eor}"

while true; do
    echo "$inactive"
    rec=""
    playerctl -F metadata -f "$fmt" 2>/dev/null | while IFS= read -r line; do
        if [ -z "$rec" ] && [ -z "$line" ]; then
            echo "$inactive"
            continue
        fi
        rec+=$line
        if [ "${line: -1}" != "$eor" ]; then
            rec+=" "   # newline inside a field
            continue
        fi
        rec=${rec%"$eor"}
        IFS=$sep read -r name status title artist arturl length <<< "$rec"
        rec=""
        if [ -z "$name" ]; then
            echo "$inactive"
            continue
        fi
        name=$(real_name "$name")
        art=$(cache_art "$arturl")
        [[ $length =~ ^[0-9]+$ ]] || length=0
        jq -cn --arg name "$name" --arg status "$status" --arg title "$title" \
               --arg artist "$artist" --arg art "$art" --argjson length "$length" \
               'def trim: gsub("^\\s+|\\s+$"; "");   # a joined-away newline at a field edge
                {active:true,player:$name,status:$status,title:($title|trim),artist:($artist|trim),art:$art,length:$length}'
    done
    sleep 2
done

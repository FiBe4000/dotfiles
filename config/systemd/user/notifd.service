# Notification server for the eww bar/popups/center (scripts/notifd).
# Started from hyprland.lua autostart and, through
# local/share/dbus-1/services/org.freedesktop.Notifications.service, by D-Bus
# activation: both go through this one unit, so there is never a second
# instance racing for the name.
[Unit]
Description=notifd desktop notification server
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
# Plasma's plasmashell owns the name in Plasma sessions: skip, don't fail.
ExecCondition=/bin/sh -c 'case ":$${XDG_CURRENT_DESKTOP}:" in *:KDE:*) exit 1 ;; esac'
ExecStart=%h/.dotfiles/scripts/notifd
Restart=on-failure
RestartSec=1
# Cheap hardening that keeps D-Bus, Wayland (wl-copy) and the Hyprland socket
# working: all three are AF_UNIX. AF_NETLINK is for gdk-pixbuf's glycin image
# loaders: they run in bwrap --unshare-all, which sets up the loopback of its
# new network namespace over netlink -- without it every icon/image decode
# fails ("Loader process exited early"). No PrivateTmp (apps send image-path
# files in /tmp) and no ProtectHome (ExecStart, icons, state and cache live there).
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
MemoryMax=512M

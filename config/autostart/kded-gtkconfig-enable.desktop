[Desktop Entry]
Type=Application
Name=Re-enable kded6 gtkconfig
Comment=Hyprland disables kded6's GTK sync module in the shared kded rc; turn it back on for Plasma
# Via sh because systemd's xdg-autostart-generator checks that the Exec binary
# exists before expanding ~ and skips the entry when a ~/ program is not found;
# ~ inside an argument is expanded fine.
Exec=sh -c "~/.dotfiles/scripts/kded-gtkconfig on"
OnlyShowIn=KDE;
NoDisplay=true
# Only plasma_session (startkderc systemdBoot=false) reads this; the systemd
# generator used by default ignores it.
X-KDE-autostart-phase=1

#!/usr/bin/env python3
"""Desktop notification server for the eww bar, popups and notification center.

Owns org.freedesktop.Notifications (spec 1.3) on the session bus and keeps all
notification state; eww only renders it. Runs as notifd.service (systemd user
unit, also the D-Bus activation target), never as an eww deflisten child:
launch-eww-bars restarts the eww daemon on every bar-set change, and the bus
name must survive that.

State for eww, rewritten atomically (tmp + rename) at most ~10 times a second
and only when it changed, under $XDG_RUNTIME_DIR/notifd/:

    bar.json     {"count", "dnd", "inhibited", "center_open"}
    popup<k>.json  <item> + {"used", "leaving"}, one file per slot
                 (k = 0..SLOTS-1): a progress line rewrites only its own
                 slot, so eww re-renders one card instead of all of them.
                 Content-only changes of a slot are throttled to POPUP_MIN_MS;
                 a slot filling, leaving or freeing is written at once.
    center.json  {"empty", "groups": [{"gid", "app", "icon", "count",
                                       "expanded", "items": [<item>]}]}
                 (collapsed groups carry only their newest item; "count" has all)

    <item> = {"id", "app", "summary", "body" (Pango markup), "text" (plain
              body), "icon" (path), "badge" (app icon path when "icon" is an
              image), "urgency" 0-2, "progress" (-1 or 0-100), "actions":
              [{"i", "label"}], "has_default", "time" ("5m"), "clock" ("14:03")}

The popup window (config/eww/scripts/notif-popups) is opened and closed by
notifd itself: once per burst, when the first slot fills and ~POPUP_CLOSE_MS
after the last one has animated out. eww leaks a little on every open/close,
and a layer surface can't let clicks through, so it is never left open empty.

eww talks back through scripts/notifctl, which calls the private interface
se.dotfiles.Notifd. Only integers (ids, action and group indices) cross that
boundary, never notification text or app-supplied action keys: eww runs
onclick handlers through `sh -c`.

History (newest first, capped) and the DND flag persist in
~/.local/state/notifd/history.json; image-data pixels are cached as PNGs in
~/.cache/notifd/. NOTIFD_RUNTIME_DIR / NOTIFD_STATE_DIR / NOTIFD_CACHE_DIR
override the three directories (testing on a private bus).
"""
import hashlib
import html
import json
import math
import os
import queue
import re
import signal
import subprocess
import stat
import sys
import tempfile
import threading
import time

# Gtk is only used for icon theme lookups; keep it from starting the
# accessibility bus and gvfs.
os.environ.setdefault("NO_AT_BRIDGE", "1")
os.environ.setdefault("GIO_USE_VFS", "local")

import gi  # noqa: E402

gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk", "3.0")
from gi.repository import GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

try:
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix
    DesktopAppInfo = GioUnix.DesktopAppInfo
except (ImportError, ValueError):
    DesktopAppInfo = Gio.DesktopAppInfo

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
RUNTIME_DIR = os.environ.get("NOTIFD_RUNTIME_DIR", os.path.join(RUNTIME, "notifd"))
STATE_DIR = os.environ.get("NOTIFD_STATE_DIR", os.path.expanduser("~/.local/state/notifd"))
CACHE_DIR = os.environ.get("NOTIFD_CACHE_DIR", os.path.expanduser("~/.cache/notifd"))
HISTORY_FILE = os.path.join(STATE_DIR, "history.json")
GTK_SETTINGS = os.path.expanduser("~/.config/gtk-3.0/settings.ini")
CENTER_CMD = os.path.expanduser("~/.config/eww/scripts/notif-center")
POPUPS_CMD = os.path.expanduser("~/.config/eww/scripts/notif-popups")

SLOTS = 5                     # must match the popup slots in notifications.yuck
HISTORY_MAX = 100
TIMEOUTS = {0: 5000, 1: 10000, 2: 0}  # ms per urgency (low, normal, critical); 0 = never
CRITICAL_PER_APP = 3          # of the SLOTS, see show_popup
HOLD_MIN_MS = 1500            # time left after a hovered popup is released
LEAVE_MS = 250                # popup exit: eww's revealer :duration (200ms) + a frame of slack
POPUP_CLOSE_MS = 300          # close the popup window this long after the last slot freed
WRITE_MIN_MS = 100            # coalesce state writes to ~10 Hz
HISTORY_DEBOUNCE_MS = 1000
RELEASE_DELAY_MS = 1000       # cached images outlive their last state line (release_files)
IMAGE_MAX = 256               # px, image-data is scaled down to fit
SUMMARY_MAX, BODY_MAX = 200, 2000
BODY_LINES = 10               # a card never grows past this many body lines
ACTIONS_MAX, ACTION_KEY_MAX = 8, 200
PATH_IMAGE_MAX_BYTES = 8 << 20  # app-supplied image files
ICON_CACHE_MAX = 500
CENTER_MIN_MS = 500           # center.json rewrites at most twice a second (eww rebuilds every card)
POPUP_MIN_MS = 250            # content-only rewrites of one popup slot (progress spam)
ICON_SIZE = 64

NOTIF_PATH = "/org/freedesktop/Notifications"
NOTIF_IFACE = "org.freedesktop.Notifications"
CTL_NAME = CTL_IFACE = "se.dotfiles.Notifd"
CTL_PATH = "/se/dotfiles/Notifd"


#!/usr/bin/env bash

# Launches eww bars on the appropriate monitors.
# - Standalone (no external monitors): bar on eDP-1
# - Docked (external monitors): bar on each external monitor, no bar on eDP-1
#
# Eww uses monitor indices (not Hyprland connector names) for --screen.
# We map from hyprctl monitor data to eww indices.
#
# When the set of bars has to change we restart the whole eww daemon instead of
# closing and reopening windows. Eww's StatusNotifierHost is per *daemon*: it
# syncs the already-registered tray items once, at daemon start, and a systray
# widget created later only ever fills from live add_item events. So a rebuilt
# bar comes up with an empty tray, and only apps that re-announce themselves to
# a new host (libayatana-appindicator: nm-applet, gammastep) reappear — Electron
# and Qt ones (teams-for-linux, outlook-for-linux, kgpg) stay gone until they
# are restarted. Killing the daemon forces a fresh sync and brings all of them
# back.
#
# Only one instance may run at a time. `eww open` forks a daemon whenever none
# is reachable, so two overlapping runs each `eww kill` a daemon that may not
# have bound its socket yet and then each fork one of their own. Both bind the
# same socket path; the loser keeps its bar but can never be reached again, so
# one monitor ends up with two bars. That happened on docked login when the
# Hyprland autostart and hypr-monitor-hotplug both ran this script; the hotplug
# daemon is now the only launcher at login, and this lock serialises its
# remaining callers (its own event/poll paths, hypr-toggle-laptop-display). A
# run that waited on the lock usually finds the wanted bars already up and
# exits; the daemon kill below clears any orphan left over from before the lock.
#
# Exit status: 1 if no usable monitors were found (nothing was changed), so a
# caller can retry; 0 otherwise.
exec 9> "${XDG_RUNTIME_DIR:-/tmp}/launch-eww-bars.lock"
flock 9

# Monitor info: "<name> <eww index>", index = position in hyprctl's output.
# Virtual outputs are dropped from the bar set (but not from the numbering):
# Hyprland lists a "FALLBACK" output while no real monitor is attached, and
# HEADLESS-* covers `hyprctl output create` — neither should get a bar, and
# counting them as external would also hide the eDP-1 bar during an undock.
monitor_data=$(hyprctl monitors -j | jq -r 'to_entries[]
    | select(.value.name != "FALLBACK" and (.value.name | startswith("HEADLESS-") | not))
    | "\(.value.name) \(.key)"')

# Bail on a transient hyprctl/jq failure rather than tearing the bars down.
[[ -n "$monitor_data" ]] || exit 1

# Check if any external monitors exist
has_external=false
while IFS=' ' read -r name idx; do
    if [[ "$name" != "eDP-1" ]]; then
        has_external=true
        break
    fi
done <<< "$monitor_data"

# Build the desired bar set: "<eww index> <id>" per line
desired=""
while IFS=' ' read -r name idx; do
    if [[ "$has_external" == true ]]; then
        # Docked — bars on external monitors only
        [[ "$name" == "eDP-1" ]] && continue
    fi
    desired+="${idx} bar-${name}"$'\n'
done <<< "$monitor_data"

# Nothing to do if exactly the wanted bars are already up. `eww active-windows`
# prints "<id>: <name>" per open instance (`list-windows` only lists window
# definitions, so stale bar-<monitor> ids never matched there).
#
# eww's own bookkeeping is not enough: when outputs vanish under it (suspend
# while docked, then resume) the bar layer surfaces get destroyed but the
# daemon keeps listing the windows as open, so the bars stay gone. Also require
# an "eww-bar" layer to actually be mapped on each wanted monitor.
active=$(eww active-windows 2>/dev/null | sed -n 's/^\(bar-[^:]*\):.*/\1/p' | sort)
mapped=$(hyprctl layers -j 2>/dev/null | jq -r 'to_entries[]
    | select([.value.levels[][] | .namespace] | index("eww-bar"))
    | "bar-\(.key)"' | sort)
wanted=$(cut -d' ' -f2- <<< "$desired" | grep -v '^$' | sort)
[[ "$active" == "$wanted" && "$mapped" == "$wanted" ]] && exit 0

# Full daemon restart — see the note on the tray above. The first `eww open`
# forks into the daemon, which inherits our stdout and never closes it, so a
# caller that pipes this script's output would hang; eww keeps its own log in
# ~/.cache/eww/ anyway.
# `eww kill` only reaches the daemon that owns the socket path; the kill
# below also takes out any orphaned daemon (see the lock note above) so its bar
# disappears instead of lingering under the new ones. Then wait (up to 2s) for
# them to actually exit -- a new `eww open` while the old one is still bound
# would talk to the dying daemon -- and SIGKILL whatever is left.
#
# Daemons are told apart from short-lived clients (`eww update` from the osd
# and dashboard scripts, `eww logs`) by their parent: a daemon forks away from
# the `eww open` that spawned it and gets reparented to the systemd user
# manager (subreaper) or PID 1, while a client's parent is the shell running it.
eww_daemon_pids() {
    local pid ppid
    ps -C eww -o pid=,ppid= | while read -r pid ppid; do
        if [[ "$ppid" == 1 || "$(ps -o comm= -p "$ppid")" == systemd ]]; then
            echo "$pid"
        fi
    done
}
daemons=$(eww_daemon_pids)
eww kill 2>/dev/null
[[ -n "$daemons" ]] && kill $daemons 2>/dev/null
for _ in {1..20}; do
    alive=""
    for pid in $daemons; do
        kill -0 "$pid" 2>/dev/null && alive+=" $pid"
    done
    [[ -z "$alive" ]] && break
    sleep 0.1
done
[[ -n "$alive" ]] && kill -KILL $alive 2>/dev/null

# fd 9 is closed for eww so the forked daemon doesn't inherit the lock and hold
# it for the rest of the session.
while IFS=' ' read -r idx id; do
    [[ -n "$id" ]] || continue
    eww open bar --screen "$idx" --id "$id" > /dev/null 2>&1 9>&-
done <<< "$desired"
exit 0

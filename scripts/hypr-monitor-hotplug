#!/usr/bin/env bash

# Listens for monitor hotplug events and manages eDP-1 (laptop display).
# When external monitors are connected: disables eDP-1
# When all external monitors are removed: re-enables eDP-1
# Respects manual toggle via /tmp/hypr-laptop-display-forced state file

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
STATE_FILE="/tmp/hypr-laptop-display-forced"
LAUNCH_BARS="$HOME/.dotfiles/scripts/launch-eww-bars"
COUNT_FILE="/tmp/hypr-ext-monitor-count"
PROFILE="$HOME/.dotfiles/scripts/hypr-display-profile.sh"

# Excludes virtual outputs: on 0.56+, when the last real monitor disappears
# (undock with eDP-1 disabled), Hyprland enters unsafe state and lists a
# "FALLBACK" output — counting it as external kept this stuck at 1 and the
# re-enable branch never fired. HEADLESS-* covers `hyprctl output create`.
count_external_monitors() {
    hyprctl monitors -j | jq '[.[] | select(
        .name != "eDP-1" and .name != "FALLBACK"
        and (.name | startswith("HEADLESS-") | not)
    )] | length'
}

# Apply a runtime config change on either config flavor: `hyprctl keyword`
# works on hyprlang sessions but is rejected by Lua-config sessions (0.55+),
# which want `hyprctl eval` instead. Both print "ok" on success.
# Usage: hypr_set <legacy keyword args...> -- <lua code>
hypr_set() {
    local legacy=()
    while [[ $# -gt 0 && "$1" != "--" ]]; do legacy+=("$1"); shift; done
    shift
    local out
    out=$(hyprctl keyword "${legacy[@]}" 2>&1)
    [[ "$out" == "ok" ]] || hyprctl eval "$1" > /dev/null
}

handle_monitors() {
    local external_count
    external_count=$(count_external_monitors)

    # Bail on a transient hyprctl failure (empty/garbage). An empty count would
    # defeat the change-detection below (""!="0"), needlessly re-applying the
    # monitor and relaunching the bars every poll — visible as periodic window
    # "jumping".
    [[ "$external_count" =~ ^[0-9]+$ ]] || return

    # Re-source each call so the per-machine eDP-1 profile self-heals if the
    # first detection raced Hyprland's startup (EDP_MODE/SCALE/EXTRA/DPI).
    source "$PROFILE"

    # Always sync Xft.dpi so newly launched X11/XWayland apps render at the
    # right size. With xwayland:force_zero_scaling=true, X11 apps render at
    # native pixels and rely on Xft.dpi for sizing. Externals are scale 1.0
    # (96 dpi); eDP-1 is scale-dependent (EDP_DPI == round(96 * scale)).
    if [[ "$external_count" -gt 0 ]]; then
        echo 'Xft.dpi: 96' | xrdb -merge 2>/dev/null
    else
        echo "Xft.dpi: $EDP_DPI" | xrdb -merge 2>/dev/null
    fi

    # Skip the rest if count hasn't changed (avoids redundant hyprctl calls and bar restarts)
    local last_count
    last_count=$(cat "$COUNT_FILE" 2>/dev/null)
    [[ "$external_count" == "$last_count" ]] && return
    echo "$external_count" > "$COUNT_FILE"

    if [[ "$external_count" -gt 0 ]]; then
        if [[ ! -f "$STATE_FILE" ]]; then
            hypr_set monitor "eDP-1,disable" -- 'hl.monitor({ output = "eDP-1", disabled = true })'
        fi
        hypr_set misc:vrr 0 -- 'hl.config({ misc = { vrr = 0 } })'
    else
        rm -f "$STATE_FILE"
        hypr_set monitor "eDP-1,${EDP_MODE},0x0,${EDP_SCALE}${EDP_EXTRA}" -- \
            "hl.monitor({ output = \"eDP-1\", mode = \"${EDP_MODE}\", position = \"0x0\", scale = \"${EDP_SCALE}\"${EDP_LUA_EXTRA} })"
        hypr_set misc:vrr 1 -- 'hl.config({ misc = { vrr = 1 } })'
        # Verify eDP-1 actually came up; fall back to full reload if not
        sleep 1
        if ! hyprctl monitors -j | jq -e '.[] | select(.name == "eDP-1")' > /dev/null 2>&1; then
            hyprctl reload
        fi
    fi

    [[ -x "$LAUNCH_BARS" ]] && "$LAUNCH_BARS"
}

# Handle initial state on startup (small delay to let monitors settle)
sleep 2
handle_monitors

# Background polling fallback — catches missed socket events (known reliability issue in 0.50+)
while sleep 5; do
    handle_monitors
done &
POLL_PID=$!
trap 'kill "$POLL_PID" 2>/dev/null' EXIT

# Listen for monitor events (fast path); reconnects if socket closes
while true; do
    socat -u UNIX-CONNECT:"$SOCKET" - 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            monitoraddedv2\>\>*|monitorremoved\>\>*|monitoradded\>\>*)
                sleep 1
                handle_monitors
                ;;
        esac
    done
    sleep 1
done
